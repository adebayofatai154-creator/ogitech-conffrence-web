# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ogitech_conference"

# Session signing secret - generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Cloudinary (never expose these to the browser)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public site URL, used for metadata and share links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed-only: initial admin account. Never reuse in production after first run.
SEED_ADMIN_EMAIL="admin@ogitech.edu.ng"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
SEED_ADMIN_NAME="Conference Administrator"

# Conference contact details (safe to edit without touching code)
CONFERENCE_EMAIL="conference@ogitech.edu.ng"
CHAIRMAN_NAME="Engr. Ifeka O. I."
CHAIRMAN_PHONE="0807650613"
SECRETARY_NAME="Engr. Adeimpe H. A."
SECRETARY_PHONE="0703399672"
BANK_ACCOUNT_NAME="School of Engineering Technology"
